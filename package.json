{
  "name": "codemirror-lang-rst",
  "version": "0.1.0",
  "description": "reStructuredText language support for CodeMirror 6",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean && tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run build:demo",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "codemirror",
    "restructuredtext",
    "rst",
    "editor",
    "language"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0"
  },
  "dependencies": {
    "@lezer/highlight": "^1.2.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.9",
    "codemirror": "^6.0.2",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
